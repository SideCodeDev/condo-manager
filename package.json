{
  "name": "condo-manager",
  "version": "1.0.0",
  "author": "",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "dev:web": "pnpm --filter @condo-manager/web dev",
    "build:web": "pnpm --filter @condo-manager/web build",
    "dev:website": "pnpm --filter @condo-manager/website dev",
    "build:website": "pnpm --filter @condo-manager/website build",
    "dev:ui": "pnpm --filter @condo-manager/ui storybook",
    "build:ui": "pnpm --filter @condo-manager/ui build",
    "dev:android": "pnpm --filter @condo-manager/mobile android",
    "dev:ios": "pnpm --filter @condo-manager/mobile ios",
    "dev:backend": "pnpm --filter @condo-manager/backend dev"
  },
  "devDependencies": {
    "@condo-manager/prettier-config": "workspace:*",
    "@condo-manager/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
